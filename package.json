{
  "name": "vibewire",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "api": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "npm run test:renaming && npm run test:routing && npm run test:route-style && npm run test:bulkhead-dots && npm run test:connectors && npm run test:inline-connectors && npm run test:gauge && npm run test:hierarchy && npm run test:manufacturing && npm run test:undo && npm run test:enclosure-kind && npm run test:domain-model && npm run test:branch-point-families && npm run test:join-choice && npm run test:canvas-images && npm run test:presence && npm run test:collab-api && npm run test:collab-auth && npm run test:collab-state && npm run test:docs",
    "test:renaming": "tsx scripts/test-renaming.ts",
    "test:routing": "tsx scripts/test-subsystem-routing.ts",
    "test:route-style": "tsx scripts/test-route-style.ts",
    "test:bulkhead-dots": "tsx scripts/test-bulkhead-dots.ts",
    "test:connectors": "tsx scripts/test-connector-families.ts",
    "test:inline-connectors": "tsx scripts/test-inline-connectors.ts",
    "test:gauge": "tsx scripts/test-gauge.ts",
    "test:hierarchy": "tsx scripts/test-hierarchy-move.ts",
    "test:manufacturing": "tsx scripts/test-manufacturing.ts",
    "test:undo": "tsx scripts/test-undo.ts",
    "test:enclosure-kind": "tsx scripts/test-enclosure-kind.ts",
    "test:domain-model": "tsx scripts/test-domain-model.ts",
    "test:branch-point-families": "tsx scripts/test-branch-point-families.ts",
    "test:join-choice": "tsx scripts/test-join-choice.ts",
    "test:canvas-images": "tsx scripts/test-canvas-images.ts",
    "test:presence": "tsx scripts/test-presence.ts",
    "test:collab-api": "tsx scripts/test-collab-api.ts",
    "test:collab-auth": "tsx scripts/test-collab-auth.ts",
    "test:collab-state": "tsx scripts/test-collab-state.ts",
    "test:docs": "tsx scripts/check-docs.ts",
    "validate": "python3 scripts/validate_system.py",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@xyflow/react": "^12.10.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
